# DYYY 34.5 step 1: public UIKit hook only
TARGET = iphone:clang:latest:14.0
ARCHS = arm64
DEBUG = 0
FINALPACKAGE = 1
include $(THEOS)/makefiles/common.mk
TWEAK_NAME = DYYY34Step7
DYYY34Step7_FILES = DYYY34Step7.xm
DYYY34Step7_CFLAGS = -fobjc-arc -O0
DYYY34Step7_FRAMEWORKS = UIKit Foundation
DYYY34Step7_LOGOS_DEFAULT_GENERATOR = internal
export THEOS_STRICT_LOGOS=0
export ERROR_ON_WARNINGS=0
include $(THEOS_MAKE_PATH)/tweak.mk
.PHONY: build
build: all
	@mkdir -p build-step7
	@cp .theos/obj/arm64/DYYY34Step7.dylib build-step7/DYYY34Step7.dylib
	@cp DYYY34Step7.plist build-step7/DYYY34Step7.plist
